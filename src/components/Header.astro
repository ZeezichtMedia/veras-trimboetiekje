---
import { base, navItems, site } from '../data/site';

// Trailing slashes wegstrippen zodat /pad en /pad/ hetzelfde matchen.
const strip = (v: string) => v.replace(/\/+$/, '') || '/';
const path = strip(Astro.url.pathname);
const home = strip(`${base}/`);
const isActive = (href: string) => {
  const h = strip(href);
  return h === home ? path === home : path.startsWith(h);
};
---

<!-- Topbar — secundaire links (algemene voorwaarden bovenaan op elke pagina) -->
<div class="bg-beige/50 border-b border-line/50 text-bark-mute">
  <div class="container-soft flex items-center justify-end gap-5 py-1.5 text-[0.7rem] tracking-[0.08em]">
    <span class="hidden sm:inline">Uitsluitend op afspraak</span>
    <span class="hidden sm:inline opacity-40">·</span>
    <a href={`${base}/voorwaarden`} class="hover:text-rose transition-colors">Algemene voorwaarden</a>
  </div>
</div>

<header class="site-header sticky top-0 z-40 backdrop-blur bg-cream/85 border-b border-line/60" data-site-header>
  <div class="container-soft flex items-center justify-between gap-6 py-3">
    <a href={`${base}/`} class="brand flex items-center gap-3" aria-label={`Home, ${site.name}`}>
      <!-- Logo van Vera. Bovenaan de pagina groot, zodat de tekst in de badge
           te lezen is; het hangt dan over de onderrand van de balk. Zodra je
           scrolt krimpt het in de balk en komt de woordnaam ernaast. Het vak
           houdt altijd de kleine maat, dus de balk verandert nooit van hoogte
           en de pagina springt niet. -->
      <span class="brand-slot relative block w-12 h-12 lg:w-14 lg:h-14 shrink-0">
        <img
          src="/brand/veras-trimboetiekje-logo.webp"
          alt=""
          width="152"
          height="152"
          loading="eager"
          decoding="async"
          class="brand-logo"
        />
      </span>
      <span class="brand-word font-display text-lg leading-none">
        <span class="block tracking-tight">Vera's</span>
        <span class="block text-rose italic text-sm leading-none -mt-0.5">Trimboetiekje</span>
      </span>
    </a>

    <nav aria-label="Hoofdmenu" class="hidden lg:flex items-center gap-7">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-sm transition-colors hover:text-rose',
            isActive(item.href) ? 'text-rose' : 'text-bark-soft',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-3">
      <a href={site.bookingUrl} class="btn-primary text-sm">
        Plan een afspraak
      </a>
    </div>

    <button
      type="button"
      class="lg:hidden grid place-items-center w-10 h-10 rounded-full border border-line text-bark"
      aria-label="Menu openen"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-line/60 bg-cream"
    data-menu
  >
    <nav aria-label="Mobielmenu" class="container-soft py-4 flex flex-col gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'py-3 px-2 rounded-lg text-base transition-colors',
            isActive(item.href) ? 'text-rose bg-nude/15' : 'text-bark hover:bg-beige/40',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a href={site.bookingUrl} class="btn-primary mt-3 w-full">
        Plan een afspraak
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-site-header]');
    if (!header) return;
    const toggle = header.querySelector('[data-menu-toggle]');
    const menu = header.querySelector('[data-menu]');

    // Compact zodra er gescrold is, of zolang het mobiele menu open staat
    // (anders valt de grote badge over de menu-items heen).
    const update = () => {
      const menuOpen = !!menu && !menu.classList.contains('hidden');
      header.classList.toggle('is-compact', window.scrollY > 8 || menuOpen);
    };

    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        const open = menu.classList.toggle('hidden') === false;
        toggle.setAttribute('aria-expanded', String(open));
        update();
      });
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
</script>

<style>
  .brand-logo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    transition:
      width 520ms cubic-bezier(0.16, 1, 0.3, 1),
      height 520ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 520ms cubic-bezier(0.16, 1, 0.3, 1),
      scale 400ms ease;
  }
  .brand:hover .brand-logo {
    scale: 1.03;
  }

  .brand-word {
    transition:
      opacity 360ms ease,
      transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Bovenaan de pagina: grote badge die over de balk heen hangt, tot in de
     topbalk erboven. Alleen met JavaScript, want zonder script kan de header
     niet terugschakelen en zou de grote badge over de inhoud blijven hangen. */
  :global(html.js) .site-header:not(.is-compact) .brand-logo {
    width: 7.25rem;
    height: 7.25rem;
    transform: translateY(-2.125rem);
  }
  :global(html.js) .site-header:not(.is-compact) .brand-word {
    opacity: 0;
    transform: translateX(-0.5rem);
  }
  @media (min-width: 1024px) {
    :global(html.js) .site-header:not(.is-compact) .brand-logo {
      width: 9.5rem;
      height: 9.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-logo,
    .brand-word {
      transition: none;
    }
  }
</style>
