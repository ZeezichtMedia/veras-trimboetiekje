---
import { navItems, site } from '../data/site';

// Trailing slashes wegstrippen zodat /pad en /pad/ hetzelfde matchen.
const strip = (v: string) => v.replace(/\/+$/, '') || '/';
const path = strip(Astro.url.pathname);
const home = '/';
const isActive = (href: string) => {
  const h = strip(href);
  return h === home ? path === home : path.startsWith(h);
};
---

<!-- Header ligt fixed over de pagina. Bovenaan is hij volledig doorzichtig,
     zonder lijn of eigen achtergrond, zodat de grote logo-badge naadloos op de
     pagina ligt. Zodra je scrolt verschijnt de balk met achtergrond en lijn.
     De ruimte die de header bovenaan inneemt zit in de eerste sectie van elke
     pagina (zie --header-h in global.css), zodat de sfeerkleuren van die
     sectie tot helemaal bovenaan doorlopen, achter de header langs. -->
<header class="site-header fixed inset-x-0 top-0 z-40" data-site-header>
  <!-- Topbalk: voorwaarden bovenaan was een wens van Vera. Klapt in zodra je
       scrolt, net als toen hij nog met de pagina mee wegscrolde. -->
  <div class="topbar text-bark-mute">
    <div class="container-soft h-full flex items-center justify-end gap-5 text-[0.7rem] tracking-[0.08em]">
      <span class="hidden sm:inline">Uitsluitend op afspraak</span>
      <span class="hidden sm:inline opacity-40">·</span>
      <a href="/voorwaarden" class="hover:text-rose transition-colors">Algemene voorwaarden</a>
    </div>
  </div>

  <div class="container-soft flex items-center justify-between gap-6 h-[4.5rem] lg:h-20">
    <a href="/" class="brand flex items-center gap-3" aria-label={`Home, ${site.name}`}>
      <!-- Logo van Vera. Bovenaan de pagina groot, zodat de tekst in de badge
           te lezen is; het hangt dan over de onderrand van de balk. Zodra je
           scrolt krimpt het in de balk en komt de woordnaam ernaast. Het vak
           houdt altijd de kleine maat, dus de balk verandert nooit van hoogte
           en de pagina springt niet. -->
      <span class="brand-slot relative block w-12 h-12 lg:w-14 lg:h-14 shrink-0">
        <!-- Twee versies op dezelfde plek. Met tekst alleen als de badge alleen
             en groot staat (bovenaan op desktop). Overal waar de woordnaam
             ernaast staat de versie zonder tekst: de naam staat er dan al als
             echte tekst, en de letters in de badge zijn op die maat toch niet
             te lezen. -->
        <img
          src="/brand/veras-trimboetiekje-logo.webp"
          alt=""
          width="152"
          height="152"
          loading="eager"
          decoding="async"
          class="brand-logo brand-logo--full"
        />
        <img
          src="/brand/veras-trimboetiekje-logo-mark.webp"
          alt=""
          width="152"
          height="152"
          loading="eager"
          decoding="async"
          class="brand-logo brand-logo--mark"
        />
      </span>
      <span class="brand-word font-display text-lg leading-none">
        <span class="block tracking-tight">Vera's</span>
        <span class="block text-rose italic text-sm leading-none -mt-0.5">Trimboetiekje</span>
      </span>
    </a>

    <nav aria-label="Hoofdmenu" class="hidden lg:flex items-center gap-7">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-sm transition-colors hover:text-rose',
            isActive(item.href) ? 'text-rose' : 'text-bark-soft',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-3">
      <a href={site.bookingUrl} class="btn-primary text-sm">
        Plan een afspraak
      </a>
    </div>

    <button
      type="button"
      class="lg:hidden grid place-items-center w-11 h-11 rounded-full border border-line text-bark"
      aria-label="Menu openen"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-line/60 bg-cream"
    data-menu
  >
    <nav aria-label="Mobielmenu" class="container-soft py-4 flex flex-col gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'py-3 px-2 rounded-lg text-base transition-colors',
            isActive(item.href) ? 'text-rose bg-nude/15' : 'text-bark hover:bg-beige/40',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a href={site.bookingUrl} class="btn-primary mt-3 w-full">
        Plan een afspraak
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-site-header]');
    if (!header) return;
    const toggle = header.querySelector('[data-menu-toggle]');
    const menu = header.querySelector('[data-menu]');

    // is-compact: er is gescrold (balk, klein logo, topbalk ingeklapt).
    // menu-open: balk en klein logo, maar de topbalk blijft staan, zodat de
    // menuknop niet onder je vinger wegschuift als je hem bovenaan opent.
    const update = () => {
      const menuOpen = !!menu && !menu.classList.contains('hidden');
      header.classList.toggle('is-compact', window.scrollY > 8);
      header.classList.toggle('menu-open', menuOpen);
    };

    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        const open = menu.classList.toggle('hidden') === false;
        toggle.setAttribute('aria-expanded', String(open));
        update();
      });
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('pageshow', update);
    update();
  })();
</script>

<style>
  .site-header {
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 450ms ease,
      border-color 450ms ease;
  }
  /* Gescrold: de balk zoals hij altijd was. Zonder JavaScript altijd deze
     stand, anders zou een doorzichtige header over de tekst heen schuiven. */
  .site-header.is-compact,
  .site-header.menu-open,
  :global(html:not(.js)) .site-header {
    background-color: color-mix(in srgb, var(--color-cream) 85%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom-color: color-mix(in srgb, var(--color-line) 60%, transparent);
  }

  .topbar {
    height: 1.75rem;
    overflow: hidden;
    transition:
      height 450ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 300ms ease,
      visibility 0s;
  }
  .site-header.is-compact .topbar {
    height: 0;
    opacity: 0;
    visibility: hidden; /* ook niet meer met tab bereikbaar */
    transition:
      height 450ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 300ms ease,
      visibility 0s linear 450ms;
  }

  .brand-logo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    transition:
      width 520ms cubic-bezier(0.16, 1, 0.3, 1),
      height 520ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 520ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 360ms ease,
      scale 400ms ease;
  }
  .brand:hover .brand-logo {
    scale: 1.03;
  }
  .brand-logo--full {
    opacity: 0;
  }
  .brand-logo--mark {
    opacity: 1;
  }

  .brand-word {
    transition:
      opacity 360ms ease,
      transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brand-slot {
    transition: width 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Bovenaan de pagina: grote badge. Alleen met JavaScript, want zonder
     script kan de header niet terugschakelen.

     Mobiel: badge 116px en het vak groeit mee, zodat de woordnaam ernaast
     blijft staan. De letters in de badge zijn op die maat maar ~3px hoog,
     dus zonder woordnaam zou er op een telefoon geen leesbare naam staan.
     Het midden van de badge valt dan precies op het midden van de balk. */
  :global(html.js) .site-header:not(.is-compact):not(.menu-open) .brand-slot {
    width: 7.25rem;
  }
  :global(html.js) .site-header:not(.is-compact):not(.menu-open) .brand-logo {
    width: 7.25rem;
    height: 7.25rem;
    transform: translateY(-2.125rem);
  }

  /* Heel smalle telefoons (< 360px): iets kleinere badge, anders past de
     woordnaam met de menuknop er niet meer naast. */
  @media (max-width: 359px) {
    :global(html.js) .site-header:not(.is-compact):not(.menu-open) .brand-slot,
    :global(html.js) .site-header:not(.is-compact):not(.menu-open) .brand-logo {
      width: 5.75rem;
    }
    :global(html.js) .site-header:not(.is-compact):not(.menu-open) .brand-logo {
      height: 5.75rem;
      transform: translateY(-1.25rem);
    }
  }

  /* Desktop: badge 152px, groot genoeg om de naam erin te lezen. Het vak
     blijft klein en de woordnaam verdwijnt, de badge is dan zelf het logo. */
  @media (min-width: 1024px) {
    :global(html.js) .site-header:not(.is-compact):not(.menu-open) .brand-slot {
      width: 3.5rem;
    }
    :global(html.js) .site-header:not(.is-compact):not(.menu-open) .brand-logo {
      width: 9.5rem;
      height: 9.5rem;
    }
    :global(html.js) .site-header:not(.is-compact):not(.menu-open) .brand-word {
      opacity: 0;
      transform: translateX(-0.5rem);
    }
    :global(html.js) .site-header:not(.is-compact):not(.menu-open) .brand-logo--full {
      opacity: 1;
    }
    :global(html.js) .site-header:not(.is-compact):not(.menu-open) .brand-logo--mark {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .topbar,
    .site-header.is-compact .topbar,
    .brand-slot,
    .brand-logo,
    .brand-word {
      transition: none;
    }
  }
</style>
