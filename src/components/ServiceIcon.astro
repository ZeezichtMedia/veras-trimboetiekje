---
/* Iconen uit Phosphor (https://phosphoricons.com, MIT), gewicht "light".
   Die dunne lijn past bij de haarlijnen en de Fraunces-koppen; regular is te
   zwaar voor deze site en thin valt weg op de kleinere maten.

   De paden komen uit @iconify-json/ph en worden tijdens de build inline in de
   HTML gezet. Er gaat dus geen icoonlettertype of losse request naar de
   browser, en er draait geen extra integratie in de build. */

import phosphor from '@iconify-json/ph/icons.json';

interface Props {
  /** Naam zonder set-prefix, bv. "scissors-light". */
  name: string;
  /** Weergavemaat in px. */
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = '' } = Astro.props;

const icon = phosphor.icons[name as keyof typeof phosphor.icons];

if (!icon) {
  throw new Error(
    `ServiceIcon: icoon "${name}" bestaat niet in Phosphor. ` +
      `Controleer de naam, inclusief het gewicht (bijvoorbeeld "dog-light").`
  );
}

const w = icon.width ?? phosphor.width ?? 256;
const h = icon.height ?? phosphor.height ?? 256;
---

<svg
  width={size}
  height={size}
  viewBox={`0 0 ${w} ${h}`}
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={icon.body}
/>
