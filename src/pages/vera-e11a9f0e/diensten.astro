---
import Layout from '../../layouts/Layout.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import Placeholder from '../../components/Placeholder.astro';
import { photos } from '../../data/images';
import { services } from '../../data/services';
import { base, site } from '../../data/site';
---

<Layout
  title="Diensten"
  description="Een overzicht van alle behandelingen bij Vera's Trimboetiekje, van complete trimbeurt tot puppy wenbeurt en extra verzorging."
>
  <!-- Header: één sterk sfeerbeeld als anker voor de hele pagina, in plaats
       van een zwakke foto bij elke afzonderlijke dienst. -->
  <section class="relative overflow-hidden pt-16 pb-20">
    <div class="soft-blob bg-nude/30 w-[400px] h-[400px] -top-32 right-0"></div>
    <div class="container-soft relative grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7">
        <span class="eyebrow">Diensten</span>
        <h1 class="mt-4 font-display text-4xl md:text-5xl lg:text-6xl leading-tight">
          Iedere hond is anders en verdient een behandeling die <span class="italic text-rose">past bij hem of haar</span>.
        </h1>
        <p class="mt-6 max-w-2xl text-lg">
          In mijn salon werk ik rustig en met aandacht, zodat jouw hond zich op zijn gemak voelt en de behandeling zo prettig mogelijk verloopt. Twijfel je welke behandeling het beste past? Neem gerust contact op, ik denk graag met je mee.
        </p>
      </div>

      <div class="lg:col-span-5 reveal">
        <Placeholder
          src={photos.tools.src}
          alt={photos.tools.alt}
          variant="beige"
          ratio="4 / 3"
          rounded="26px"
          width={1400}
          loading="eager"
          class="shadow-card"
        />
      </div>
    </div>
  </section>

  <!-- Diensten: editorial lijst met haarlijnen. Geen foto's, want een
       trimbehandeling laat zich niet eerlijk verbeelden met beeld dat niet
       in deze salon is gemaakt. Het icoon en het nummer dragen de kaart. -->
  <section class="pb-24">
    <div class="container-soft">
      {services.map((s, i) => (
        <article
          id={s.slug}
          class="reveal grid lg:grid-cols-12 gap-x-12 gap-y-6 border-t border-line py-12 md:py-16 scroll-mt-28"
        >
          <div class="lg:col-span-4 flex items-start gap-6">
            <span class="font-body text-xs tracking-[0.22em] text-bark-mute pt-2 tabular-nums">
              {String(i + 1).padStart(2, '0')}
            </span>
            <ServiceIcon name={s.icon} size={76} stroke={1.1} class="text-rose shrink-0" />
          </div>

          <div class="lg:col-span-8 max-w-2xl">
            <h2 class="font-display text-2xl md:text-3xl leading-tight">{s.title}</h2>
            <div class="mt-5 space-y-3">
              {s.body.map((p) => (
                <p>{p}</p>
              ))}
            </div>
            <div class="mt-7 flex flex-wrap gap-3">
              <a href={`${base}/prijzen`} class="btn-secondary text-sm">Bekijk prijzen</a>
              <a href={site.bookingUrl} class="btn-primary text-sm">Plan een afspraak</a>
            </div>
          </div>
        </article>
      ))}
      <div class="border-t border-line"></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-24">
    <div class="container-soft">
      <div class="bg-beige/40 rounded-[28px] p-10 md:p-14 text-center max-w-3xl mx-auto border border-line/60">
        <h2 class="font-display text-2xl md:text-3xl">
          Twijfel je welke behandeling het <span class="italic text-rose">beste past</span>?
        </h2>
        <p class="mt-4 max-w-xl mx-auto">
          Stuur me gerust een berichtje. Ik help je graag bij de keuze die het beste past bij de vacht én het karakter van jouw hond.
        </p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href={site.whatsappUrl} target="_blank" rel="noopener" class="btn-primary">WhatsApp Vera</a>
          <a href={`${base}/contact`} class="btn-secondary">Naar contact</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
