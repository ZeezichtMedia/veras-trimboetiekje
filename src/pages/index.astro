---
/* ──────────────────────────────────────────────────────────────
   TIJDELIJKE "BINNENKORT ONLINE"-PAGINA
   ----------------------------------------------------------------
   Deze pagina vervangt voorlopig de volledige website. De echte
   site staat ongewijzigd in  src/pages/_full-site/  (Astro negeert
   mappen die met een underscore beginnen, dus die routes bouwen
   niet mee).

   TERUGZETTEN bij livegang:
     1. Verplaats alle bestanden uit  src/pages/_full-site/  terug
        naar  src/pages/  (de echte index.astro overschrijft dan
        dit bestand).
     2. Verwijder de lege  _full-site  map.
   Eén handeling, verder hoeft er niets aangepast te worden.
   ────────────────────────────────────────────────────────────── */
import '../styles/global.css';
import { site } from '../data/site';

const pageTitle = `Binnenkort online · ${site.name}`;
const description = `${site.name} in ${site.address.city}. Onze nieuwe website is bijna klaar. Neem alvast contact op via WhatsApp of Instagram.`;
const canonical = Astro.site ? new URL('/', Astro.site).toString() : '/';
---

<!doctype html>
<html lang="nl">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FAF6F0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Placeholder voorlopig uit de index houden; bij livegang vervalt dit. -->
    <meta name="robots" content="noindex, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <main class="relative min-h-screen overflow-hidden grid place-items-center px-6 py-20">
      <!-- Zachte sfeerblobs -->
      <div class="soft-blob" style="width:34rem;height:34rem;background:var(--color-nude);top:-12rem;left:-10rem;"></div>
      <div class="soft-blob" style="width:30rem;height:30rem;background:var(--color-rose);bottom:-11rem;right:-9rem;opacity:0.4;"></div>
      <div class="soft-blob" style="width:24rem;height:24rem;background:var(--color-beige-dark);top:55%;left:8%;opacity:0.3;"></div>

      <div class="relative z-10 w-full max-w-xl mx-auto flex flex-col items-center text-center">
        <!-- Merkbadge -->
        <div class="cs-badge cs-anim" style="animation-delay:0ms" aria-hidden="true">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.7">
            <circle cx="7" cy="9" r="1.7" fill="currentColor" stroke="none" />
            <circle cx="12" cy="6.4" r="1.7" fill="currentColor" stroke="none" />
            <circle cx="17" cy="9" r="1.7" fill="currentColor" stroke="none" />
            <circle cx="4.6" cy="13.6" r="1.5" fill="currentColor" stroke="none" />
            <circle cx="19.4" cy="13.6" r="1.5" fill="currentColor" stroke="none" />
            <path d="M8.4 17.4c0-2.3 1.5-3.7 3.6-3.7s3.6 1.4 3.6 3.7c0 1.8-1.5 2.7-3.6 2.7s-3.6-.9-3.6-2.7z" fill="currentColor" stroke="none" />
          </svg>
        </div>

        <p class="eyebrow cs-anim mt-7" style="animation-delay:90ms">
          Hondentrimsalon in {site.address.city}
        </p>

        <h1 class="cs-title cs-anim mt-4" style="animation-delay:170ms">
          Vera&rsquo;s <span class="italic text-rose">Trimboetiekje</span>
        </h1>

        <span class="cs-status cs-anim mt-6" style="animation-delay:250ms">
          <span class="cs-dot"></span>
          Binnenkort online
        </span>

        <p class="cs-lead cs-anim mt-7" style="animation-delay:330ms">
          We werken met veel liefde aan onze nieuwe website. Hier leest u straks
          alles over onze rustige trimsalon, waar elke hond met aandacht en in
          alle rust verzorgd wordt.
        </p>

        <p class="cs-lead cs-sub cs-anim mt-4" style="animation-delay:390ms">
          Wilt u nu al een afspraak maken of heeft u een vraag? Stuur gerust een
          berichtje, dan denken we met u mee.
        </p>

        <div class="cs-actions cs-anim mt-9" style="animation-delay:470ms">
          <a href={site.whatsappUrl} target="_blank" rel="noopener" class="btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.5 14.4c-.3-.15-1.7-.83-1.96-.93-.26-.1-.45-.14-.64.14-.19.28-.73.92-.9 1.11-.16.19-.33.21-.61.07-.28-.14-1.18-.43-2.25-1.38-.83-.74-1.39-1.66-1.55-1.94-.16-.28-.02-.43.12-.57.13-.13.28-.33.42-.5.14-.16.18-.28.28-.47.09-.19.05-.35-.02-.49-.07-.14-.64-1.54-.88-2.11-.23-.55-.46-.48-.64-.49h-.54c-.19 0-.49.07-.75.35-.26.28-.98.96-.98 2.34s1.01 2.71 1.15 2.9c.14.19 1.98 3.02 4.8 4.24.67.29 1.19.46 1.6.59.67.21 1.28.18 1.76.11.54-.08 1.66-.68 1.89-1.33.23-.65.23-1.21.16-1.33-.07-.12-.25-.19-.53-.33z M12 2.2A9.8 9.8 0 0 0 3.5 17l-1.3 4.8 4.9-1.29A9.8 9.8 0 1 0 12 2.2zm0 17.9c-1.48 0-2.93-.4-4.19-1.15l-.3-.18-2.86.75.76-2.79-.2-.29A8.13 8.13 0 1 1 12 20.1z" />
            </svg>
            Stuur een berichtje
          </a>
          <a href={site.instagram} target="_blank" rel="noopener" class="btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="0.9" fill="currentColor" stroke="none" />
            </svg>
            Volg ons op Instagram
          </a>
        </div>

        <div class="cs-rule cs-anim" style="animation-delay:560ms" aria-hidden="true"></div>

        <div class="cs-meta cs-anim" style="animation-delay:620ms">
          <span>{site.address.street}, {site.address.postalCode} {site.address.city}</span>
          <span class="cs-meta-sep" aria-hidden="true">·</span>
          <span>{site.hours}</span>
        </div>
      </div>

      <!-- Agensea-signatuur -->
      <a
        href="https://agensea.nl"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Website ontworpen en gebouwd door Agensea"
        class="cs-credit cs-anim"
        style="animation-delay:760ms"
      >
        <span class="cs-credit-label">Gebouwd door</span>
        <img src="/brand/agensea-logo.svg" alt="Agensea" class="cs-credit-logo" width="120" height="32" loading="lazy" decoding="async" />
      </a>
    </main>

    <style>
      /* ── Merkbadge ─────────────────────────────── */
      .cs-badge {
        display: grid;
        place-items: center;
        width: 4.5rem;
        height: 4.5rem;
        border-radius: 999px;
        background: var(--color-beige);
        color: var(--color-rose);
        box-shadow: var(--shadow-soft);
        border: 1px solid rgba(201, 155, 130, 0.25);
      }

      /* ── Titel ─────────────────────────────────── */
      .cs-title {
        font-family: var(--font-display);
        font-weight: 400;
        letter-spacing: -0.02em;
        line-height: 1.04;
        color: var(--color-bark);
        font-size: clamp(2.6rem, 7vw, 4.4rem);
      }

      /* ── Status-pill ───────────────────────────── */
      .cs-status {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.4rem 0.95rem;
        border-radius: 999px;
        background: rgba(250, 246, 240, 0.8);
        border: 1px solid var(--color-line);
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-bark-soft);
        backdrop-filter: blur(4px);
      }
      .cs-dot {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 999px;
        background: var(--color-rose);
        animation: cs-pulse 2.4s ease-in-out infinite;
      }

      /* ── Lopende tekst ─────────────────────────── */
      .cs-lead {
        max-width: 34rem;
        color: var(--color-bark-soft);
        font-size: 1.05rem;
        line-height: 1.75;
      }
      .cs-sub {
        font-size: 0.98rem;
        color: var(--color-bark-mute);
      }

      /* ── Knoppen ───────────────────────────────── */
      .cs-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.85rem;
      }

      /* ── Scheidingslijn + meta ─────────────────── */
      .cs-rule {
        width: 3rem;
        height: 1px;
        background: var(--color-line);
        margin-top: 3rem;
      }
      .cs-meta {
        margin-top: 1.5rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        font-size: 0.82rem;
        color: var(--color-bark-mute);
      }
      .cs-meta-sep {
        opacity: 0.4;
      }

      /* ── Agensea-signatuur ─────────────────────── */
      .cs-credit {
        position: absolute;
        bottom: 1.75rem;
        left: 50%;
        transform: translateX(-50%);
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        z-index: 10;
        text-decoration: none;
      }
      .cs-credit-label {
        font-size: 0.65rem;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--color-bark-mute);
        opacity: 0.55;
        transition: opacity 500ms cubic-bezier(0.16, 1, 0.3, 1);
      }
      .cs-credit-logo {
        height: 19px;
        width: auto;
        filter: brightness(0);
        opacity: 0.55;
        transition:
          opacity 500ms cubic-bezier(0.16, 1, 0.3, 1),
          filter 500ms cubic-bezier(0.16, 1, 0.3, 1),
          transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
        transform-origin: left center;
      }
      .cs-credit:hover .cs-credit-label {
        opacity: 0.9;
      }
      .cs-credit:hover .cs-credit-logo {
        opacity: 1;
        filter:
          brightness(0)
          drop-shadow(0 0 6px rgba(99, 102, 241, 0.35))
          drop-shadow(0 0 14px rgba(99, 102, 241, 0.18));
        transform: scale(1.03);
      }
      .cs-credit:focus-visible {
        outline: 2px solid #6366f1;
        outline-offset: 6px;
        border-radius: 2px;
      }

      /* ── Entree-animatie ───────────────────────── */
      @keyframes cs-rise {
        from {
          opacity: 0;
          transform: translateY(18px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes cs-pulse {
        0%,
        100% {
          box-shadow: 0 0 0 0 rgba(201, 155, 130, 0.5);
        }
        70% {
          box-shadow: 0 0 0 7px rgba(201, 155, 130, 0);
        }
      }
      html.js .cs-anim {
        opacity: 0;
        animation: cs-rise 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      @media (prefers-reduced-motion: reduce) {
        html.js .cs-anim {
          opacity: 1;
          animation: none;
        }
        .cs-dot {
          animation: none;
        }
      }
    </style>
  </body>
</html>
